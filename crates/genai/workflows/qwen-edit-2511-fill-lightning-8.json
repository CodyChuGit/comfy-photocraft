{
  "meta": {
    "id": "qwen-edit-2511/fill-lightning-8",
    "name": "Generative Fill (Qwen-Image-Edit-2511, Lightning 8 steps)",
    "family": "qwen-image-edit-2511",
    "task": "fill",
    "license": "permissive",
    "licenseNote": "Qwen-Image-Edit-2511 is Apache-2.0 (Alibaba Qwen, 2025-12-23); the Lightning LoRA is Apache-2.0 (lightx2v, 2026-01).",
    "minComfyVersion": "0.4.0",
    "saveNode": "16",
    "needsImage": true,
    "needsMask": true,
    "defaults": { "steps": 8, "guidance": 1.0 },
    "placeholders": {
      "prompt": "string", "negative": "string", "seed": "int", "steps": "int", "cfg": "float",
      "image": "string", "mask": "string", "prefix": "string",
      "unet": "string", "clip": "string", "vae": "string", "lora": "string"
    },
    "models": [
      { "placeholder": "unet", "folder": "diffusion_models", "default": "qwen_image_edit_2511_fp8mixed.safetensors" },
      { "placeholder": "clip", "folder": "text_encoders", "default": "qwen_2.5_vl_7b_fp8_scaled.safetensors" },
      { "placeholder": "vae", "folder": "vae", "default": "qwen_image_vae.safetensors" },
      { "placeholder": "lora", "folder": "loras", "default": "Qwen-Image-Edit-2511-Lightning-8steps-V1.0-bf16.safetensors" }
    ],
    "promptFormat": "Add {prompt} to this image, fitting the scene's perspective, lighting and surroundings naturally. Change nothing else.",
    "promptFormatImperative": "{prompt}. Fit the result to the scene's perspective, lighting and surroundings naturally, and change nothing else.",
    "notes": "The `qwen-edit-2511/fill` graph with the 8-step Lightning LoRA (LoraLoaderModelOnly after CFGNorm, as ComfyUI's official template wires its 4-step option): 8 steps at CFG 1 instead of 40 at CFG 4, about five times faster with little loss. Needs the 850 MB `Qwen-Image-Edit-2511-Lightning-8steps-V1.0-bf16.safetensors` in ComfyUI/models/loras (https://huggingface.co/lightx2v/Qwen-Image-Edit-2511-Lightning)."
  },
  "graph": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip}}", "type": "qwen_image", "device": "default" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
    "4": { "class_type": "LoadImage", "inputs": { "image": "{{image}}", "upload": "image" } },
    "5": { "class_type": "FluxKontextImageScale", "inputs": { "image": ["4", 0] } },
    "6": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{prompt}}", "vae": ["3", 0], "image1": ["5", 0] } },
    "7": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{negative}}", "vae": ["3", 0], "image1": ["5", 0] } },
    "8": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.1 } },
    "9": { "class_type": "CFGNorm", "inputs": { "model": ["8", 0], "strength": 1.0 } },
    "19": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["9", 0], "lora_name": "{{lora}}", "strength_model": 1.0 } },
    "10": { "class_type": "VAEEncode", "inputs": { "pixels": ["4", 0], "vae": ["3", 0] } },
    "11": { "class_type": "LoadImage", "inputs": { "image": "{{mask}}", "upload": "image" } },
    "12": { "class_type": "ImageToMask", "inputs": { "image": ["11", 0], "channel": "red" } },
    "13": { "class_type": "SetLatentNoiseMask", "inputs": { "samples": ["10", 0], "mask": ["12", 0] } },
    "17": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["6", 0], "reference_latents_method": "index_timestep_zero" } },
    "18": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["7", 0], "reference_latents_method": "index_timestep_zero" } },
    "14": { "class_type": "KSampler", "inputs": { "model": ["19", 0], "positive": ["17", 0], "negative": ["18", 0], "latent_image": ["13", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
    "15": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["3", 0] } },
    "16": { "class_type": "SaveImage", "inputs": { "images": ["15", 0], "filename_prefix": "{{prefix}}" } }
  }
}
