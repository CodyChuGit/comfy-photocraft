{
  "meta": {
    "id": "qwen-edit-2511/image-ref",
    "name": "Generate Image from References (Qwen-Image-Edit-2511, Lightning 8 steps)",
    "family": "qwen-image-edit-2511",
    "task": "image",
    "license": "permissive",
    "licenseNote": "Qwen-Image-Edit-2511 is Apache-2.0 (Alibaba Qwen, 2025-12-23); the Lightning LoRA is Apache-2.0 (lightx2v, 2026-01).",
    "minComfyVersion": "0.4.0",
    "saveNode": "16",
    "needsImage": false,
    "needsMask": false,
    "defaults": { "steps": 8, "guidance": 1.0 },
    "placeholders": {
      "prompt": "string", "negative": "string", "seed": "int", "steps": "int", "cfg": "float",
      "width": "int", "height": "int", "image1": "string", "image2": "string", "image3": "string", "prefix": "string",
      "unet": "string", "clip": "string", "vae": "string", "lora": "string"
    },
    "models": [
      { "placeholder": "unet", "folder": "diffusion_models", "default": "qwen_image_edit_2511_fp8mixed.safetensors" },
      { "placeholder": "clip", "folder": "text_encoders", "default": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "nvfp4": "qwen_2.5_vl_7b_nvfp4.safetensors" },
      { "placeholder": "vae", "folder": "vae", "default": "qwen_image_vae.safetensors" },
      { "placeholder": "lora", "folder": "loras", "default": "Qwen-Image-Edit-2511-Lightning-8steps-V1.0-bf16.safetensors" }
    ],
    "notes": "A new picture guided by one to three reference images (the Generate panel's deck in Image mode): ComfyUI's official 'Image Edit (Qwen-Image 2511)' nodes with the references on image1..image3 of both TextEncodeQwenImageEditPlus encoders, straight from LoadImage as the official graph wires its extra images, and an EmptySD3LatentImage of the requested size in place of the encoded picture (the pattern of ComfyUI's official Krea 2 style-reference graph, which feeds its references the same way and samples an empty latent). The 8-step Lightning LoRA as in `edit-lightning-8`. The prompt names the references as image 1, image 2, image 3 ('the person in image 1 wearing the jacket from image 2'). Verified against a live server's /object_info on 2026-10-11 (ComfyUI 0.39). References not given are pruned with their LoadImage node.",
    "creator": "Alibaba Qwen",
    "description": "A new picture guided by one to three reference images",
    "badges": ["references"],
    "references": {"max": 3, "min": 1, "placeholders": ["image1", "image2", "image3"], "nodes": {"image1": ["4"], "image2": ["20"], "image3": ["21"]}},
    "sizes": {"aspects": ["1:1", "3:2", "2:3", "4:3", "3:4", "16:9", "9:16"], "min": 512, "max": 2048, "step": 16},
    "estimatedSeconds": {"base": 7.5, "perMegapixel": 5.5, "perReference": 9},
    "pages": ["image"]
  },
  "graph": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip}}", "type": "qwen_image", "device": "default" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
    "4": { "class_type": "LoadImage", "inputs": { "image": "{{image1}}", "upload": "image" } },
    "20": { "class_type": "LoadImage", "inputs": { "image": "{{image2}}", "upload": "image" } },
    "21": { "class_type": "LoadImage", "inputs": { "image": "{{image3}}", "upload": "image" } },
    "6": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{prompt}}", "vae": ["3", 0], "image1": ["4", 0], "image2": ["20", 0], "image3": ["21", 0] } },
    "7": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{negative}}", "vae": ["3", 0], "image1": ["4", 0], "image2": ["20", 0], "image3": ["21", 0] } },
    "8": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.1 } },
    "9": { "class_type": "CFGNorm", "inputs": { "model": ["8", 0], "strength": 1.0 } },
    "19": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["9", 0], "lora_name": "{{lora}}", "strength_model": 1.0 } },
    "10": { "class_type": "EmptySD3LatentImage", "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 } },
    "17": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["6", 0], "reference_latents_method": "index_timestep_zero" } },
    "18": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["7", 0], "reference_latents_method": "index_timestep_zero" } },
    "14": { "class_type": "KSampler", "inputs": { "model": ["19", 0], "positive": ["17", 0], "negative": ["18", 0], "latent_image": ["10", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
    "15": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["3", 0] } },
    "16": { "class_type": "SaveImage", "inputs": { "images": ["15", 0], "filename_prefix": "{{prefix}}" } }
  }
}
