{
  "meta": {
    "id": "qwen-edit-2511/remove-lightning-8",
    "name": "Generative Remove (Qwen-Image-Edit-2511, Object Remover LoRA, Lightning 8 steps)",
    "family": "qwen-image-edit-2511",
    "task": "fill",
    "license": "permissive",
    "licenseNote": "Qwen-Image-Edit-2511 is Apache-2.0 (Alibaba Qwen, 2025-12-23); the Lightning LoRA is Apache-2.0 (lightx2v, 2026-01); the Object Remover v2 LoRA is Apache-2.0 (prithivMLmods, 2026-01).",
    "minComfyVersion": "0.4.0",
    "saveNode": "16",
    "needsImage": true,
    "needsMask": true,
    "highlight": "red",
    "defaults": { "steps": 8, "guidance": 1.0 },
    "placeholders": {
      "prompt": "string", "negative": "string", "seed": "int", "steps": "int", "cfg": "float", "sampler": "string", "scheduler": "string",
      "image": "string", "mask": "string", "prefix": "string",
      "unet": "string", "clip": "string", "vae": "string", "lora": "string", "remover": "string"
    },
    "models": [
      { "placeholder": "unet", "folder": "diffusion_models", "default": "qwen_image_edit_2511_fp8mixed.safetensors" },
      { "placeholder": "clip", "folder": "text_encoders", "default": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "nvfp4": "qwen_2.5_vl_7b_nvfp4.safetensors" },
      { "placeholder": "vae", "folder": "vae", "default": "qwen_image_vae.safetensors" },
      { "placeholder": "lora", "folder": "loras", "default": "Qwen-Image-Edit-2511-Lightning-8steps-V1.0-bf16.safetensors" },
      { "placeholder": "remover", "folder": "loras", "default": "Qwen-Image-Edit-2511-Object-Remover-v2-9200.safetensors" }
    ],
    "promptFormat": "{prompt}",
    "promptFormatImperative": "{prompt}",
    "notes": "The `qwen-edit-2511/fill-lightning-8` graph with a second LoraLoaderModelOnly after the Lightning one: prithivMLmods' Object Remover v2 (https://huggingface.co/prithivMLmods/QIE-2511-Object-Remover-v2, 225 MB, trained on 2511 to delete what is painted red). `highlight` tells the engine to paint the hole solid red in the request picture and to send the adapter's trigger sentence, \"Remove the red highlighted object from the scene.\", instead of the removal wording; the noise mask and the layer mask are as for any fill. Stacking with the Lightning LoRA is the measurement of 2026-10-22 (benchmarks.md 5i).",
    "creator": "Alibaba Qwen",
    "description": "Removes what the selection covers with an adapter trained for it: 8 steps",
    "badges": ["fast"],
    "estimatedSeconds": {"base": 7.5, "perMegapixel": 5.5},
    "pages": ["fill"]
  },
  "graph": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip}}", "type": "qwen_image", "device": "default" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
    "4": { "class_type": "LoadImage", "inputs": { "image": "{{image}}", "upload": "image" } },
    "5": { "class_type": "FluxKontextImageScale", "inputs": { "image": ["4", 0] } },
    "6": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{prompt}}", "vae": ["3", 0], "image1": ["5", 0] } },
    "7": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{negative}}", "vae": ["3", 0], "image1": ["5", 0] } },
    "8": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.1 } },
    "9": { "class_type": "CFGNorm", "inputs": { "model": ["8", 0], "strength": 1.0 } },
    "19": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["9", 0], "lora_name": "{{lora}}", "strength_model": 1.0 } },
    "20": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["19", 0], "lora_name": "{{remover}}", "strength_model": 1.0 } },
    "10": { "class_type": "VAEEncode", "inputs": { "pixels": ["4", 0], "vae": ["3", 0] } },
    "11": { "class_type": "LoadImage", "inputs": { "image": "{{mask}}", "upload": "image" } },
    "12": { "class_type": "ImageToMask", "inputs": { "image": ["11", 0], "channel": "red" } },
    "13": { "class_type": "SetLatentNoiseMask", "inputs": { "samples": ["10", 0], "mask": ["12", 0] } },
    "17": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["6", 0], "reference_latents_method": "index_timestep_zero" } },
    "18": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["7", 0], "reference_latents_method": "index_timestep_zero" } },
    "14": { "class_type": "KSampler", "inputs": { "model": ["20", 0], "positive": ["17", 0], "negative": ["18", 0], "latent_image": ["13", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "denoise": 1.0 } },
    "15": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["3", 0] } },
    "16": { "class_type": "SaveImage", "inputs": { "images": ["15", 0], "filename_prefix": "{{prefix}}" } }
  }
}
