{
  "meta": {
    "id": "qwen-layered/split",
    "name": "Split into Layers (Qwen-Image-Layered)",
    "family": "qwen-image-layered",
    "task": "layers",
    "license": "permissive",
    "licenseNote": "Qwen-Image-Layered is Apache-2.0 (Alibaba Qwen, 2025-12); the ComfyUI repack Comfy-Org/Qwen-Image-Layered_ComfyUI is Apache-2.0. The app ships no weights.",
    "minComfyVersion": "0.39.0",
    "saveNode": "16",
    "needsImage": true,
    "needsMask": false,
    "defaults": { "steps": 20, "guidance": 2.5 },
    "placeholders": {
      "prompt": "string", "negative": "string", "seed": "int", "steps": "int", "cfg": "float",
      "image": "string", "prefix": "string", "width": "int", "height": "int", "layers": "int",
      "unet": "string", "clip": "string", "vae": "string"
    },
    "models": [
      { "placeholder": "unet", "folder": "diffusion_models", "default": "qwen_image_layered_fp8mixed.safetensors" },
      { "placeholder": "clip", "folder": "text_encoders", "default": "qwen_2.5_vl_7b_fp8_scaled.safetensors" },
      { "placeholder": "vae", "folder": "vae", "default": "qwen_image_layered_vae.safetensors" }
    ],
    "notes": "ComfyUI's official 'Image to Layers (Qwen-Image-Layered)' subgraph (image_qwen_image_layered.json, 2026-10): the picture, VAE-encoded with the layered VAE, enters both conditionings as a ReferenceLatent; EmptyQwenImageLayeredLatentImage makes a latent with `layers` slices at the request's size (multiples of 16; the official graph scales the input to 640 px on its longer side, which the engine does too); ModelSamplingAuraFlow shift 1; KSampler euler/simple 20 steps CFG 2.5; LatentCut drops slice 0 (the whole picture) and LatentCutToBatch turns the remaining slices into a batch, so VAEDecode (RGBA with this VAE) and SaveImage give one PNG per layer, background first. Needs the 19 GB fp8 repack qwen_image_layered_fp8mixed.safetensors and qwen_image_layered_vae.safetensors (https://huggingface.co/Comfy-Org/Qwen-Image-Layered_ComfyUI) plus the Qwen2.5-VL 7B text encoder the 2511 templates use."
  },
  "graph": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip}}", "type": "qwen_image", "device": "default" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
    "4": { "class_type": "LoadImage", "inputs": { "image": "{{image}}", "upload": "image" } },
    "5": { "class_type": "VAEEncode", "inputs": { "pixels": ["4", 0], "vae": ["3", 0] } },
    "6": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{{prompt}}" } },
    "7": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{{negative}}" } },
    "8": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 1.0 } },
    "9": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["6", 0], "latent": ["5", 0] } },
    "10": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["7", 0], "latent": ["5", 0] } },
    "11": { "class_type": "EmptyQwenImageLayeredLatentImage", "inputs": { "width": "{{width}}", "height": "{{height}}", "layers": "{{layers}}", "batch_size": 1 } },
    "12": { "class_type": "KSampler", "inputs": { "model": ["8", 0], "positive": ["9", 0], "negative": ["10", 0], "latent_image": ["11", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
    "13": { "class_type": "LatentCut", "inputs": { "samples": ["12", 0], "dim": "t", "index": 1, "amount": 16384 } },
    "14": { "class_type": "LatentCutToBatch", "inputs": { "samples": ["13", 0], "dim": "t", "slice_size": 1 } },
    "15": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["3", 0] } },
    "16": { "class_type": "SaveImage", "inputs": { "images": ["15", 0], "filename_prefix": "{{prefix}}" } }
  }
}
