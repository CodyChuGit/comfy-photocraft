{
  "meta": {
    "id": "qwen-edit-2511/fill-ref",
    "name": "Generative Fill from a Reference (Qwen-Image-Edit-2511, 40 steps)",
    "family": "qwen-image-edit-2511",
    "task": "fill",
    "license": "permissive",
    "licenseNote": "Qwen-Image-Edit-2511 is Apache-2.0 (Alibaba Qwen, 2025-12-23).",
    "minComfyVersion": "0.4.0",
    "saveNode": "16",
    "needsImage": true,
    "needsMask": true,
    "eraseSelection": true,
    "defaults": { "steps": 40, "guidance": 4.0 },
    "placeholders": {
      "prompt": "string", "negative": "string", "seed": "int", "steps": "int", "cfg": "float",
      "image": "string", "mask": "string", "image2": "string", "image3": "string", "prefix": "string",
      "unet": "string", "clip": "string", "vae": "string"
    },
    "models": [
      { "placeholder": "unet", "folder": "diffusion_models", "default": "qwen_image_edit_2511_fp8mixed.safetensors" },
      { "placeholder": "clip", "folder": "text_encoders", "default": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "nvfp4": "qwen_2.5_vl_7b_nvfp4.safetensors" },
      { "placeholder": "vae", "folder": "vae", "default": "qwen_image_vae.safetensors" }
    ],
    "promptFormat": "The other images are references. The flat grey area of image 1 is the only part to change: paint {prompt} there, taken from the references exactly as they show it (its type, colour, material, pattern, details and fit), fitted to the pose, perspective and lighting of image 1, so that no grey remains. Keep everything outside that area exactly as it is.",
    "promptFormatImperative": "The other images are references and the flat grey area of image 1 is the only part to change. {prompt}. Take it from the references exactly as they show it (type, colour, material, pattern, details and fit), fitted to the pose, perspective and lighting of image 1, so that no grey remains. Keep everything outside that area exactly as it is.",
    "notes": "`fill` (40 steps at CFG 4) with one or two reference images on `image2`/`image3`, the selection flattened to mid-grey in the request (`eraseSelection`) and the prompt naming the hole: see `fill-ref-lightning-8` and docs/comfy/research/notes/ausboss-krea2-clothing-workflow.md. Quality `best` under Auto takes this one when references are given.",
    "creator": "Alibaba Qwen",
    "description": "Paints the selection with what a reference image shows, with 40 steps",
    "badges": ["40 steps", "reference"],
    "references": {"max": 2, "placeholders": ["image2", "image3"], "nodes": {"image2": ["20"], "image3": ["21"]}},
    "estimatedSeconds": {"base": 20, "perMegapixel": 160, "perReference": 40},
    "pages": ["fill"]
  },
  "graph": {
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
    "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip}}", "type": "qwen_image", "device": "default" } },
    "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
    "4": { "class_type": "LoadImage", "inputs": { "image": "{{image}}", "upload": "image" } },
    "20": { "class_type": "LoadImage", "inputs": { "image": "{{image2}}", "upload": "image" } },
    "21": { "class_type": "LoadImage", "inputs": { "image": "{{image3}}", "upload": "image" } },
    "5": { "class_type": "FluxKontextImageScale", "inputs": { "image": ["4", 0] } },
    "6": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{prompt}}", "vae": ["3", 0], "image1": ["5", 0], "image2": ["20", 0], "image3": ["21", 0] } },
    "7": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "prompt": "{{negative}}", "vae": ["3", 0], "image1": ["5", 0], "image2": ["20", 0], "image3": ["21", 0] } },
    "8": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.1 } },
    "9": { "class_type": "CFGNorm", "inputs": { "model": ["8", 0], "strength": 1.0 } },
    "10": { "class_type": "VAEEncode", "inputs": { "pixels": ["4", 0], "vae": ["3", 0] } },
    "11": { "class_type": "LoadImage", "inputs": { "image": "{{mask}}", "upload": "image" } },
    "12": { "class_type": "ImageToMask", "inputs": { "image": ["11", 0], "channel": "red" } },
    "13": { "class_type": "SetLatentNoiseMask", "inputs": { "samples": ["10", 0], "mask": ["12", 0] } },
    "17": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["6", 0], "reference_latents_method": "index_timestep_zero" } },
    "18": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["7", 0], "reference_latents_method": "index_timestep_zero" } },
    "14": { "class_type": "KSampler", "inputs": { "model": ["9", 0], "positive": ["17", 0], "negative": ["18", 0], "latent_image": ["13", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
    "15": { "class_type": "VAEDecode", "inputs": { "samples": ["14", 0], "vae": ["3", 0] } },
    "16": { "class_type": "SaveImage", "inputs": { "images": ["15", 0], "filename_prefix": "{{prefix}}" } }
  }
}
